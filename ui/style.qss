/* ============================================================
   Prometheus — dark theme
   ------------------------------------------------------------
   Rules (owner's standing preferences):
     - Text is always neutral (white / grey). Colour lives in
       bars, borders and fills — never in text.
     - No pills or badges.
     - Dark backgrounds everywhere, including dialogs.
   Palette
     window   #121212   surface #171717   card   #1e1e1e
     raised   #252525   border  #2b2b2b   strong #3a3a3a
     text     #ececec   text-2  #a6a6a6   text-3 #6f6f6f
     accent   #f0a500   (bars, borders, primary fill only)
   ============================================================ */

/* ── Base ─────────────────────────────────────────────────── */
QMainWindow, QDialog {
    background-color: #121212;
}
QWidget {
    color: #ececec;
    font-family: "Segoe UI", "SF Pro Text", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 13px;
}
/* Labels never paint their own box (this caused the black
   rectangles behind text on cards) */
QLabel {
    background: transparent;
}
QToolTip {
    background-color: #252525;
    color: #ececec;
    border: 1px solid #3a3a3a;
    padding: 4px 8px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4a4a4a; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 1px;
}
QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border-radius: 2px;
}

QMenu {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    padding: 4px;
}
QMenu::item {
    padding: 7px 24px 7px 12px;
    border-left: 3px solid transparent;
}
QMenu::item:selected {
    background-color: #252525;
    border-left: 3px solid #f0a500;
}
QMenu::separator {
    height: 1px;
    background: #2b2b2b;
    margin: 4px 6px;
}

/* ── Header ───────────────────────────────────────────────── */
#header {
    background-color: #0e0e0e;
    border-bottom: 1px solid #2b2b2b;
}
#headerTitle {
    color: #ececec;
    letter-spacing: 3px;
    border-left: 3px solid #f0a500;
    padding-left: 10px;
}
#headerDay {
    color: #a6a6a6;
    font-size: 12px;
    padding-left: 14px;
}
#headerBtn {
    background-color: transparent;
    color: #a6a6a6;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
}
#headerBtn:hover {
    background-color: #1e1e1e;
    color: #ececec;
    border-color: #2b2b2b;
}
#headerBtn:checked {
    color: #ececec;
    border-bottom: 2px solid #f0a500;
}
#headerBtn::menu-indicator { image: none; width: 0; }

/* ── Tab bar ──────────────────────────────────────────────── */
#tabBar {
    background-color: #121212;
    border-bottom: 1px solid #2b2b2b;
}
#tabScroll, #tabContainer {
    background-color: transparent;
    border: none;
}
QScrollArea#tabScroll { border: none; background: transparent; }

#tabBtn {
    background-color: transparent;
    color: #a6a6a6;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 4px 12px;
    font-size: 13px;
}
#tabBtn:hover {
    color: #ececec;
    border-bottom: 2px solid #3a3a3a;
}
#tabBtnActive, #tabBtn:checked {
    background-color: transparent;
    color: #ececec;
    border: none;
    border-bottom: 2px solid #f0a500;
    border-radius: 0px;
    padding: 4px 12px;
    font-size: 13px;
    /* same weight as inactive tabs — bold text overflowed its measured width */
}
#addTabBtn, #quickAccessBtn {
    background-color: transparent;
    color: #a6a6a6;
    border: 1px solid #2b2b2b;
    border-radius: 6px;
    font-size: 13px;
    padding: 0px 10px;
}
#addTabBtn { padding: 0px; font-size: 16px; }
#addTabBtn:hover, #quickAccessBtn:hover {
    color: #ececec;
    border-color: #f0a500;
}

/* ── Chat ─────────────────────────────────────────────────── */
#chatScroll, #messagesWidget {
    background-color: #121212;
    border: none;
}
#tabInfo {
    background-color: #121212;
    color: #6f6f6f;
    font-size: 11px;
}
#summaryBar {
    background-color: #171717;
    color: #a6a6a6;
    border: none;
    border-bottom: 1px solid #2b2b2b;
    text-align: left;
    padding-left: 16px;
    font-size: 11px;
}
#summaryBar:hover {
    color: #ececec;
    border-left: 3px solid #f0a500;
}

#bubble_user, #bubble_assistant { background-color: transparent; }
#bubble_user QLabel {
    background-color: #1f2b22;
    color: #ececec;
    border: 1px solid #2c3d30;
    border-radius: 12px;
    padding: 10px 14px;
}
#bubble_assistant QLabel {
    background-color: #1a1a1a;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-left: 3px solid #f0a500;
    border-radius: 10px;
    padding: 10px 14px;
}
#bubble_assistant #bubbleIcon {
    background: transparent;
    border: none;
    padding: 0;
    color: #6f6f6f;
}

#timingStamp {
    color: #6f6f6f;
    font-size: 10px;
    padding: 0px 0px 2px 0px;
}

/* Welcome panel (empty tab) */
#welcomePanel { background: transparent; }
#welcomeTitle {
    color: #ececec;
    font-size: 20px;
    font-weight: 600;
}
#welcomeIntro {
    color: #a6a6a6;
    font-size: 13px;
}
#welcomeHint {
    color: #6f6f6f;
    font-size: 11px;
    letter-spacing: 1px;
}
#suggestionBtn {
    background-color: #1a1a1a;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-left: 3px solid #3a3a3a;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
}
#suggestionBtn:hover {
    background-color: #202020;
    border-left: 3px solid #f0a500;
}
#checkCard {
    background-color: #171717;
    border: 1px solid #2b2b2b;
    border-left: 3px solid #f0a500;
    border-radius: 8px;
}

/* ── Input bar ────────────────────────────────────────────── */
#inputBar {
    background-color: #121212;
    border-top: 1px solid #2b2b2b;
}
QTextEdit, QPlainTextEdit {
    background-color: #1a1a1a;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #f0a500;
    selection-color: #000;
}
QTextEdit:focus { border: 1px solid #5a4a20; }

#sendBtn {
    background-color: #f0a500;
    color: #111;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
}
#sendBtn:hover { background-color: #ffb700; }
#sendBtn:disabled { background-color: #2b2b2b; color: #6f6f6f; }

#voiceBtn {
    background-color: #1a1a1a;
    color: #a6a6a6;
    border: 1px solid #2b2b2b;
    border-radius: 10px;
    font-size: 17px;
}
#voiceBtn:hover { color: #ececec; border-color: #3a3a3a; }
#voiceBtn:checked {
    background-color: #5a0f0f;
    color: #fff;
    border: 1px solid #a22;
}
#voiceBtn:disabled { color: #444; border-color: #222; }

/* ── Sidebar ──────────────────────────────────────────────── */
#sidebar {
    background-color: #151515;
    border-left: 1px solid #2b2b2b;
}
#sidebarScroll { background-color: transparent; border: none; }
#sectionHeader {
    color: #a6a6a6;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 2px 0 2px 8px;
    border-left: 3px solid #f0a500;
}
#infoRow {
    background-color: #1a1a1a;
    border-radius: 4px;
    border: 1px solid #242424;
}
#infoLabel { color: #6f6f6f; font-size: 11px; }
#infoValue { color: #ececec; font-size: 12px; }
#progressLabel { color: #a6a6a6; font-size: 12px; padding: 4px 8px; }
#smallBtn {
    background-color: #1a1a1a;
    color: #a6a6a6;
    border: 1px solid #2b2b2b;
    border-radius: 4px;
    padding: 0px;          /* small square buttons — global padding hid their text */
}
#smallBtn:hover { color: #ececec; border-color: #f0a500; }

/* ── Dialogs and form controls ────────────────────────────── */
QDialog { color: #ececec; }

QTabWidget::pane {
    border: 1px solid #2b2b2b;
    background-color: #151515;
    border-radius: 6px;
}
QTabBar::tab {
    background-color: transparent;
    color: #a6a6a6;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: #ececec; }
QTabBar::tab:selected {
    color: #ececec;
    border-bottom: 2px solid #f0a500;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1a1a1a;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #f0a500;
    selection-color: #000;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #5a4a20;
}
QComboBox::drop-down { border: none; border-left: 1px solid #2b2b2b; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #ececec;
    border: 1px solid #3a3a3a;
    selection-background-color: #2b2b2b;
    selection-color: #ececec;
}
/* Plain number fields: type or scroll (styled arrow buttons drew no arrows) */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 0px; border: none; }

QCheckBox { color: #ececec; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    background-color: #1a1a1a;
}
QCheckBox::indicator:checked { background-color: #f0a500; border-color: #f0a500; }

QPushButton {
    background-color: #1e1e1e;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-radius: 6px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: #252525; border-color: #3a3a3a; }
QPushButton:disabled { color: #555; }

#primaryBtn, #beginBtn {
    background-color: #f0a500;
    color: #111;
    border: none;
    font-weight: bold;
}
#primaryBtn:hover, #beginBtn:hover { background-color: #ffb700; }
#beginBtn { border-radius: 8px; font-size: 14px; }

#navBtn {
    background-color: #1e1e1e;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-radius: 6px;
    padding: 6px 16px;
}
#navBtn:hover { border-color: #3a3a3a; background-color: #252525; }
#navBtnSecondary {
    background-color: transparent;
    color: #a6a6a6;
    border: none;
    padding: 6px 16px;
}
#navBtnSecondary:hover { color: #ececec; }

/* Destructive action — warning shown by the bar, not the text */
#dangerBtn {
    background-color: #1e1e1e;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-left: 4px solid #d33;
    border-radius: 6px;
    padding: 6px 16px;
}
#dangerBtn:hover { background-color: #2a1a1a; }

#noteLabel {
    color: #a6a6a6;
    font-size: 11px;
    padding: 8px 10px;
    background-color: #171717;
    border-radius: 6px;
    border: 1px solid #2b2b2b;
}

QStatusBar {
    background-color: #0e0e0e;
    color: #a6a6a6;
    font-size: 11px;
    border-top: 1px solid #2b2b2b;
}
QStatusBar QLabel { color: #a6a6a6; padding: 0 8px; }
QSplitter::handle { background-color: #2b2b2b; }

QListWidget, QTableWidget {
    background-color: #151515;
    border: 1px solid #2b2b2b;
    color: #ececec;
    gridline-color: #242424;
}
QHeaderView::section {
    background-color: #1a1a1a;
    color: #a6a6a6;
    border: none;
    border-bottom: 1px solid #2b2b2b;
    padding: 5px 8px;
}
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #252525;
    color: #ececec;
}

/* ── Documents ────────────────────────────────────────────── */
#dropZone {
    background-color: #171717;
    border: 2px dashed #3a3a3a;
    border-radius: 8px;
    margin: 8px 12px 0 12px;
}
#dropZoneActive {
    background-color: #1c1a14;
    border: 2px dashed #f0a500;
    border-radius: 8px;
    margin: 8px 12px 0 12px;
}
#dropZoneLabel { color: #a6a6a6; font-size: 13px; }
#docList {
    background-color: #151515;
    border: 1px solid #2b2b2b;
    color: #ececec;
    font-size: 12px;
    padding: 4px;
}
#docList::item { padding: 6px 8px; border-left: 3px solid transparent; }
#docList::item:selected {
    background-color: #202020;
    color: #ececec;
    border-left: 3px solid #f0a500;
}
#docList::item:hover { background-color: #1e1e1e; }
#indexProgress { background-color: #1a1a1a; border: none; }
#indexProgress::chunk { background-color: #f0a500; }

/* ── Situation check (assessment) ─────────────────────────── */
#assessmentWidget { background-color: #121212; }
#assessmentHeader {
    background-color: #0e0e0e;
    border-bottom: 1px solid #2b2b2b;
}
#assessmentTitle {
    color: #ececec;
    letter-spacing: 1px;
    border-left: 3px solid #f0a500;
    padding-left: 10px;
}
#assessmentProgress { color: #6f6f6f; font-size: 12px; }
#assessmentScroll, #assessmentNav { background-color: #121212; border: none; }
#assessmentNav { border-top: 1px solid #2b2b2b; }
#progressBarBg { background-color: #222; }
#progressBarFill { background-color: #f0a500; }
#questionText { color: #ececec; }
#questionSubtitle { color: #a6a6a6; font-size: 12px; }
#optionBtn {
    background-color: #1a1a1a;
    color: #ececec;
    border: 1px solid #2b2b2b;
    border-left: 3px solid #2b2b2b;
    border-radius: 8px;
    padding: 8px 16px;
    text-align: left;
    font-size: 13px;
}
#optionBtn:hover {
    background-color: #202020;
    border-left: 3px solid #f0a500;
}
#resultsTitle { color: #ececec; }
#resultsSubtitle { color: #a6a6a6; font-size: 12px; }
#priorityCard {
    background-color: #1a1a1a;
    border: 1px solid #2b2b2b;
    border-left: 3px solid #f0a500;
    border-radius: 8px;
}
#priorityCard:hover { background-color: #202020; }
/* Number shown plainly — no filled circle */
#priorityNum {
    background: transparent;
    color: #a6a6a6;
    font-weight: bold;
    font-size: 15px;
}
#priorityTitle { color: #ececec; }
#priorityDetail { color: #a6a6a6; }
#priorityArrow { color: #6f6f6f; }

/* ── Skill tree ───────────────────────────────────────────── */
#stageCard {
    background-color: #151515;
    border: 1px solid #2b2b2b;
    border-radius: 8px;
}
#stageTitle {
    color: #ececec;
    font-weight: 600;
    padding-left: 8px;
}
#stageCount { color: #a6a6a6; font-size: 12px; }
#skillCard, #skillCardDone, #skillCardLocked {
    background-color: #1a1a1a;
    border: 1px solid #242424;
    border-radius: 4px;
}
#skillCardDone { border-left: 3px solid #3c8c4c; }
#skillName { color: #ececec; font-size: 12px; }
#skillNameLocked { color: #6f6f6f; font-size: 12px; }
#skillTab { color: #6f6f6f; font-size: 10px; }

/* ── Quick access ─────────────────────────────────────────── */
#quickBtn {
    background-color: #1a1a1a;
    border: 1px solid #2b2b2b;
    border-radius: 8px;
}
#quickBtn:hover { background-color: #202020; border-color: #3a3a3a; }
#quickLabel { color: #ececec; font-size: 13px; font-weight: 600; }

/* ── Training Path verdict row ────────────────────────────── */
#verdictBar {
    background: transparent;
    border-left: 3px solid #f0a500;
    margin-left: 32px;
}

/* ── Dev panel trace rows ─────────────────────────────────── */
#traceRow {
    background-color: #1a1a1a;
    border: 1px solid #2b2b2b;
    border-left: 4px solid #555;
    border-radius: 4px;
}
#traceRow QLabel { color: #ececec; font-size: 11px; }
#traceMeta { color: #a6a6a6; }

/* ── Messages (local network) ─────────────────────────────── */
#alertMessage {
    background-color: #1e1414;
    border: 1px solid #3a2222;
    border-left: 4px solid #d33;
    border-radius: 8px;
}

/* Source page image under an answer */
#imagePanel { background: transparent; }
#sourceImage {
    border: 1px solid #2b2b2b;
    border-radius: 4px;
}

/* "Researching <topic>…" while the Training Path works */
#researchLine {
    color: #a6a6a6;
    font-size: 12px;
    border-left: 3px solid #f0a500;
    padding-left: 10px;
}
