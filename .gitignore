# Knowledge base: commit hand-written .md files, never downloaded books,
# dumps, page images or the placeholder READMEs that ingest --init creates
knowledge_base/*
!knowledge_base/*/
knowledge_base/*/**
!knowledge_base/*/
!knowledge_base/*/*.md
knowledge_base/*/README.md
knowledge_base/wikipedia/
memory/
voices/
prometheus_setup/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store
Thumbs.db

